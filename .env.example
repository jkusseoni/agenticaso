# Database (Neon PostgreSQL + Prisma 6)
#
# Prisma schema uses:
#   url       = env("DATABASE_URL")   # Neon pooled (runtime)
#   directUrl = env("DIRECT_URL")     # Neon direct (migrations)
#
# Neon dashboard → Connect:
# DATABASE_URL = pooled host (hostname contains -pooler), sslmode=require
# DIRECT_URL   = direct compute host (no -pooler), sslmode=require
#
# Example (placeholders only — never commit real credentials):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
#
# Optional: set to false to omit storing raw AI answers
# STORE_RAW_ANSWERS=true

DATABASE_URL=
DIRECT_URL=
STORE_RAW_ANSWERS=true

# Phase 6 — Vercel Cron auth for POST /api/internal/monitoring/run
CRON_SECRET=

# Phase 7 — Billing (canonical Pro is $19/month USD)
# Optional overrides:
# BILLING_PRO_CURRENCY=USD
# BILLING_PRO_MONTHLY_CENTS=1900
# BILLING_PRO_MONTHLY_DISPLAY=19
#
# Paddle Billing — sandbox by default. Server secrets must never be NEXT_PUBLIC_*.
# Pro price is $19 USD/month in the app. The Paddle catalog price id must be that $19 recurring price.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV must match PADDLE_ENV (both sandbox, or both production).
# Do not set NEXT_PUBLIC_PADDLE_PRO_PRICE_ID — it is not read. Use PADDLE_PRICE_ID_PRO.
# Public support inbox shown on /contact (not a secret; used as mailto).
# The app defaults to support@agenticaso.com if these are unset.
# SUPPORT_EMAIL=support@agenticaso.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@agenticaso.com
# NEXT_PUBLIC_SITE_URL=https://agenticaso.com

# MCP V1 — API keys + POST /mcp. Keep disabled until you set a pepper and opt in.
# MCP_ENABLED must be the exact string true to expose /mcp and /api/mcp/keys.
# Rotating MCP_KEY_PEPPER invalidates every existing key. Never NEXT_PUBLIC_*.
MCP_ENABLED=false
MCP_KEY_PEPPER=

# Phase 3C — Growth internal worker (disabled by default; not in vercel.json cron)
# GROWTH_AGENT_ENABLED must be the exact string true to process jobs.
# Auth: GROWTH_CRON_SECRET, or CRON_SECRET if GROWTH_CRON_SECRET is unset.
GROWTH_AGENT_ENABLED=false
# GROWTH_CRON_SECRET=
# GROWTH_WORKSPACE_ALLOWLIST=
# GROWTH_WORKER_LIMIT=3
# GROWTH_AI_TIMEOUT_MS=25000
# GROWTH_WORKER_BUDGET_MS=50000
# Disposable Postgres for Growth constraint tests only (local host + db name containing growth_test):
# GROWTH_TEST_DATABASE_URL=

# Phase 4A — CartRenew dogfood seed (dry-run unless GROWTH_DOGFOOD_CONFIRM=YES)
# GROWTH_DOGFOOD_WORKSPACE_ID=
# GROWTH_DOGFOOD_URLS=
# GROWTH_DOGFOOD_CONFIRM=
# GROWTH_DOGFOOD_ENV=staging
# GROWTH_DOGFOOD_DATABASE_URL=
# GROWTH_DOGFOOD_DIRECT_URL=

